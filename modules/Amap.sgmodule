#!name=Amap Ad Block
#!desc=Converted from ddgksf2013 AmapAds.conf V1.0.28. Reinstall Amap after enabling.

[Rule]
AND,((PROTOCOL,QUIC),(DOMAIN-SUFFIX,amap.com)),REJECT

[URL Rewrite]
^https?:\/\/.*\.amap\.com\/ws\/asa\/ads_attribution - reject

[Map Local]
^https?:\/\/.*\.amap\.com\/ws\/aos\/alimama\/splash_screen data-type=text data="" status-code=200
^https?:\/\/.*\.amap\.com\/ws\/boss\/order_web\/\w{8}_information data-type=text data="" status-code=200
^https?:\/\/.*\.amap\.com\/v\d\/ai_rec\/ data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https?:\/\/.*\.amap\.com\/ws\/faas\/amap-navigation\/card-service-route-plan\? data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https?:\/\/.*\.amap\.com\/ws\/shield\/scene\/recommend data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https?:\/\/.*\.amap\.com\/ws\/valueadded\/weather data-type=text data="{}" header="Content-Type:application/json" status-code=200
^https?:\/\/.*\.amap\.com\/uploadimg\/\w+\.gif data-type=tiny-gif status-code=200

[Script]
amap-notice = type=http-response,pattern=^https?:\/\/.*\.amap\.com\/ws\/message\/notice\/list,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/amap.js,requires-body=1
amap-aocs = type=http-response,pattern=^https?:\/\/.*\.amap\.com\/ws\/shield\/frogserver\/aocs\/updatable,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/amap.js,requires-body=1
amap-nearby = type=http-response,pattern=^https?:\/\/.*\.amap\.com\/ws\/shield\/search\/nearbyrec_smart,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/amap.js,requires-body=1
amap-promotion = type=http-response,pattern=^https?:\/\/.*\.amap\.com\/ws\/promotion-web\/resource,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/amap.js,requires-body=1
amap-mainpage = type=http-response,pattern=^https?:\/\/.*\.amap\.com\/ws\/faas\/amap-navigation\/main-page,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/amap.js,requires-body=1
amap-splash = type=http-response,pattern=^https?:\/\/.*\.amap\.com\/ws\/valueadded\/alimama\/splash_screen,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/amap.js,requires-body=1
amap-msgbox = type=http-response,pattern=^https?:\/\/.*\.amap\.com\/ws\/msgbox\/pull,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/amap.js,requires-body=1
amap-profile = type=http-response,pattern=^https?:\/\/.*\.amap\.com\/ws\/shield\/dsp\/profile\/index\/nodefaas,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/amap.js,requires-body=1
amap-hotword = type=http-response,pattern=^https?:\/\/.*\.amap\.com\/ws\/shield\/search\/new_hotword,script-path=https://raw.githubusercontent.com/ddgksf2013/Scripts/refs/heads/master/amap.js,requires-body=1

[MITM]
hostname = %APPEND% m5.amap.com, m5-zb.amap.com, center.amap.com, ai.amap.com
